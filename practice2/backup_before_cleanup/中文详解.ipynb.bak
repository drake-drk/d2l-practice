   "source": [
    "X = pd.DataFrame(index=train_data.index)\n",
    "X[\"dayofweek\"] = train_data[\"pickup_datetime\"].dt.dayofweek\n",
    "X[\"month\"] = train_data[\"pickup_datetime\"].dt.month\n",
    "X[\"hour\"] = train_data[\"pickup_datetime\"].dt.hour\n",
    "X[\"dayofyear\"] = train_data[\"pickup_datetime\"].dt.dayofyear\n",
    "X[\"is_anomaly_1\"] = train_data[\"anomaly_1\"]\n",
    "X[\"is_anomaly_2\"] = train_data[\"anomaly_2\"]\n",
    "X.head()"
   ]
