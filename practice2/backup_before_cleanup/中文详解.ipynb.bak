       "                     Place of study\n",
       "                 &lt;/div&gt;`,\n",
       "                {\n",
       "  &quot;sticky&quot;: true,\n",
       "}\n",
       "            );\n",
       "        \n",
       "    \n",
       "                marker_11d6cdc6b79df37620631d96c5357672.setIcon(icon_d378217a85ef363b9cfea325f8da8d68);\n",
       "            \n",
       "&lt;/script&gt;\n",
       "&lt;/html&gt;\" width=\"100%\" height=\"480\"style=\"border:none !important;\" \"allowfullscreen\" \"webkitallowfullscreen\" \"mozallowfullscreen\"></iframe>"
      ],
      "text/plain": [
       "<folium.folium.Map at 0x713696853890>"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# BSU main building (Haloŭny korpus BDU), 4 Independence Ave. (prasp. Niezaliežnasci 4),\n",
    "# Minsk - the building where the FPMI classes take place. Coordinates taken from the OSM\n",
    "# object \"Галоўны корпус БДУ\" (building, house number 4).\n",
    "bsu_location = (53.893898, 27.546963)\n",
    "\n",
    "m = folium.Map(location=bsu_location, zoom_start=16)\n",
    "folium.Marker(\n",
    "    location=bsu_location,\n",
    "    popup=\"Belarusian State University\",\n",
    "    tooltip=\"Place of study\",\n",
    "    icon=folium.Icon(color=\"red\", icon=\"info-sign\"),\n",
    ").add_to(m)\n",
    "m.get_root().height = 480\n",
    "m"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "> **代码讲解**\n",
    "> - `bsu_location = (53.893898, 27.546963)`：把坐标存成元组，方便复用。纬度 53.8939 管南北，经度 27.5470 管东西——白大主楼（Галоўны корпус БДУ，独立大道 4 号）就在独立广场北侧。\n",
    "> - 为什么经度要精确到小数点后三位？在明斯克这个纬度上，经度 0.001° 只相当于约 66 米，写错第三位，标记就会跑到马路对面去。\n",
    "> - `folium.Marker(location=..., popup=..., tooltip=..., icon=folium.Icon(...))`：在地图上放一个标记点。`popup` 是点击后弹出的内容，`tooltip` 是鼠标悬停时的提示。\n",
    "> - `.add_to(m)`：把这些元素\"挂\"到地图对象 `m` 上。folium 的写法都是\"先创建元素，再 `add_to`\"。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**说明**：`╰( ͡° ͜ʖ ͡° )つ──☆*:・ﾟ` 这个颜文字标记的位置，就是留给你写代码和/或答案的地方。"
   ]
  },
