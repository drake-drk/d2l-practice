   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-20T21:31:17.412462Z",
     "iopub.status.busy": "2026-10-20T21:31:17.412215Z",
     "iopub.status.idle": "2026-10-20T21:31:17.833524Z",
