   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# left: the full range needs log-spaced bins, otherwise 99.9% of the trips\n",
    "# would fall into the first equal-width bin\n",
    "bins = np.logspace(0, np.log10(train_data[\"trip_duration\"].max()), 60)\n",
    "sns.histplot(train_data[\"trip_duration\"], bins=bins, ax=axes[0])\n",
    "axes[0].set_xscale(\"log\")\n",
