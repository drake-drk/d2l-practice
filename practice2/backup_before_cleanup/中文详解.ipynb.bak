    "by_month_hour = train_data.groupby([\"month\", \"hour\"]).size().reset_index(name=\"trips\")\n",
    "sns.relplot(data=by_month_hour, x=\"hour\", y=\"trips\", hue=\"month\", kind=\"line\",\n",
