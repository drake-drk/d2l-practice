     "iopub.status.idle": "2026-10-20T21:31:22.164779Z",
     "shell.execute_reply": "2026-10-20T21:31:22.163539Z"
    }
   },
   "outputs": [],
   "source": [
    "from sklearn.linear_model import Ridge\n",
