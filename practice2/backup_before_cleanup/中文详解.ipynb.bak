    "数一数每个特征有几个不同的取值："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-20T21:31:37.940293Z",
     "iopub.status.busy": "2026-10-20T21:31:37.940146Z",
     "iopub.status.idle": "2026-10-20T21:31:37.974088Z",
     "shell.execute_reply": "2026-10-20T21:31:37.972336Z"
