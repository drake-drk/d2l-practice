   ],
   "source": [
    "for col in [\"vendor_id\", \"passenger_count\", \"store_and_fwd_flag\"]:\n",
    "    print(f\"{col}: {train_data[col].nunique()} unique values -> {sorted(train_data[col].unique())}\")"
   ]
  },
  {
   "cell_type": "markdown",
