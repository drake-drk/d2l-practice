    "top_routes = routes.value_counts().head(100).index\n",
    "X[\"route_cell\"] = routes.where(routes.isin(top_routes), \"-1\")\n",
    "\n",
    "print(\"most frequent routes:\")\n",
    "print(routes.value_counts().head(5))\n",
    "print(\"route_cell categories:\", X[\"route_cell\"].nunique())"
   ]
