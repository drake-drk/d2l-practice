   "source": [
    "summary = pd.DataFrame({\n",
    "    \"features\": [\"none\", \"vendor_id\", \"store_and_fwd_flag\", \"passenger_count\", \"all three\"],\n",
    "    \"RMSLE\": [rmsle_wo, s_vendor, s_flag, s_pass, rmsle_all3],\n",
