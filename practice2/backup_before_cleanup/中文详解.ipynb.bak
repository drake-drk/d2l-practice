   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "vendor_id: 2 unique values -> [np.int64(1), np.int64(2)]\n",
      "passenger_count: 10 unique values -> [np.int64(0), np.int64(1), np.int64(2), np.int64(3), np.int64(4), np.int64(5), np.int64(6), np.int64(7), np.int64(8), np.int64(9)]\n",
      "store_and_fwd_flag: 2 unique values -> ['N', 'Y']\n"
     ]
