  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "For each pair (day of the week, hour of the day), calculate the median of the speeds. Draw a graph using `sns.heatmap`, where the axes will be the days of the week and the hours, and the value of the function will be the median of the speed "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#╰( ͡° ͜ʖ ͡° )つ──☆*:・ﾟ\n",
    "def heatmap(X_):\n",
    "    dw = pd.concat([X_['dayofweek'], X_['hour']], axis=1)\n",
    "    dw['speed'] = pd.Series(speed)\n",
    "    \n",
    "    df = dw.pivot_table(index='dayofweek', columns='hour', values='speed', aggfunc=np.median)\n",
    "    sns.heatmap(df, annot=False, fmt=\".1f\")\n",
    "\n",
    "    plt.show()"
   ]
